        <mxCell id="PkTBSmSXAkz1ON-lmvk_-96" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Check: `f_{sn} != f_{sn}, K_{SG}^1 = h(K_{SG}^1), update&amp;nbsp; f_{sn}`&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Compute: `K_S = h(K_{SG}^1,N_4)` (87)&lt;br&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Compute: `D(K_S,T) -&amp;gt; {C_{SN},Q_2}`&lt;/font&gt;&lt;/span&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Validate: `h(K_{SG}^1) = Q_2`&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Compute:&amp;nbsp; `R_{SN}^\prime = P_{SN} (C_{SN})` (88)&lt;br&gt;Generate:&amp;nbsp; `N_5, M`&lt;br&gt;Compute:&amp;nbsp; `MF`&lt;br&gt;Compute:&amp;nbsp; `r_4 = MK_{SG}^1 - h(R_{SN}^\prime)_{T96} C_{SN}` (89)&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Compute: `r_5 = h(r_4,K_{SG}^1,N_5)` (90)&lt;/font&gt;&lt;/blockquote&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;labelBackgroundColor=none;labelBorderColor=none;sketch=0;fontSize=21;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacingBottom=23;fontColor=#333333;" parent="1" vertex="1">

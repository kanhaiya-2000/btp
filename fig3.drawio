bsp; `\beta_{\n\ew}`&lt;/font&gt;&lt;br&gt;&lt;/blockquote&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;labelBackgroundColor=none;labelBorderColor=none;sketch=0;fontSize=21;align=left;fillColor=#f5f5f5;strokeColor=#666666;gradientDirection=south;fontColor=#333333;" parent="1" vertex="1">

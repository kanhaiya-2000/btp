        <mxCell id="PkTBSmSXAkz1ON-lmvk_-85" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 19px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Compute: `K_U = h(K_{UG}^1,N_1,N_2)` (73)&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 19px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Compute: `D(K_U,L) -&amp;gt; {C_U, Q_1}`&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 19px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Validate: `h(K_{UG}^1) = Q_1`&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 19px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Compute:&amp;nbsp; `R_U^\prime = P_U (C_U)` (74)&lt;br&gt;Generate:&amp;nbsp; `N_3, V`&lt;br&gt;Compute:&amp;nbsp; VG, VH&lt;br&gt;Compute:&amp;nbsp; `r_1 = VK_{UG}^1 - h(B_1^\prime)_{T96} C_U` (75)&lt;br&gt;Compute:&amp;nbsp; `r_2 = VK_{UG}^1 - h(R_U^\prime)_{T96} C_U` (76)&lt;/font&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: none; padding: 0px; font-size: 19px;&quot;&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Compute: `r_3=h(r_1,r_2,K_{UG}^1,N_3)` (77)&lt;/font&gt;&lt;/blockquote&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;labelBackgroundColor=none;labelBorderColor=none;sketch=0;fontSize=21;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
